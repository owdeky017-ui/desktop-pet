# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.spec
build/
dist/

# Versioned build output (e.g. build_v7/, dist_v7/, spec_v7/)
build_*/
dist_*/
spec_*/

# Virtual env (do not commit)
venv/
.venv/
env/

# Packaged binaries — these go to GitHub Releases, not the repo
DesktopPet_v69.exe
*.zip

# Your own sprites sit in the repo root and stay untracked (personal art).
# Only the root-level copies are ignored; placeholder/ ships with the repo.
/pet*.png
/mini_*.png

# Runtime data directory (vocab, logs, screenshots, generated config)
data/

# Runtime config — the app rewrites this on every change (window position, toggles).
# It doubles as the sample config, so keep it out of commits.
pet_config.json

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local notes
*.log
*.tmp